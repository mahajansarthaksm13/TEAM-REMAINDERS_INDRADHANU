# Copy to .env.local and fill in. Never commit real values (FIX-PLAN rule 5).
# Local stack: run `npx supabase status -o env` in database/ for the URL and keys.

# Browser + server
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# owner/repo of the public checkpoints repo (Y17)
NEXT_PUBLIC_CHECKPOINTS_REPO=mahajansarthaksm13/veribin-checkpoints
# Optional: a real report id shown as "Verify a sample report" on the public site
NEXT_PUBLIC_SAMPLE_REPORT_ID=

# Server only. Used for report PDF upload (A14), admin invites and the website simulator.
SUPABASE_SERVICE_ROLE_KEY=

# Website simulator (A16), server only
DEMO_BIN_ID=VB-PUN-9999-DEMO
# base64 of the 32-byte Ed25519 private key (simulator/keys/VB-PUN-9999-DEMO.key)
DEMO_BIN_PRIVATE_KEY=
# defaults to <NEXT_PUBLIC_SUPABASE_URL>/functions/v1/ingest
INGEST_URL=
